/dts-v1/;

#include "klamath.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Synaptics KLAMATH RDK";
	compatible = "Synaptics,klamath", "Synaptics,asserial";

	memory {
		device_type = "memory";
		reg = <0 0 0 0x20000000>;
	};

	chosen {
		stdout-path = &sm_uart0;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		usb0_vbus: regulator@0 {
			compatible = "regulator-fixed";
			regulator-name = "usb0_vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			gpio = <&expander0 5 GPIO_ACTIVE_HIGH>;
			enable-active-high;
		};
	};
};

&sysmgr_pinctrl {
	i2c0_pmux: i2c0-pmux {
		groups = "SM_GPIO12", "SM_GPIO13";
		function = "tw0";
	};

	xspi0_pmux: xspi0-pmux {
		groups = "SM_GPIO18", "SM_GPIO19", "SM_GPIO20", "SM_GPIO21",
				 "SM_GPIO22", "SM_GPIO23", "SM_GPIO24", "SM_GPIO25",
				 "SM_GPIO26", "SM_GPIO27", "SM_GPIO28", "SM_GPIO29",
				 "SM_GPIO30";
		function = "xspi";
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_pmux>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	i2c-sda-hold-time-ns = <449>;
	i2c-scl-rising-time-ns = <120>;
	i2c-scl-falling-time-ns = <20>;

	expander0: gpio@43 {
		compatible = "fcs,fxl6408";
		reg = <0x43>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&sm_uart0 {
	status = "okay";
};

&sdhci0 {
	status = "okay";
	pad_sn = <10>;
	pad_sp = <10>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	fixed-voltage;
};

&usb_phy0 {
	status = "okay";
};

&usb0 {
	vbus-supply = <&usb0_vbus>;
	status = "okay";
};

&usb_phy1 {
    status = "okay";
};

&usb1 {
    status = "okay";
};


&xspi0 {
	status = "okay";
	pinctrl-0 = <&xspi0_pmux>;
	pinctrl-names = "default";

	spi-flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};
};
