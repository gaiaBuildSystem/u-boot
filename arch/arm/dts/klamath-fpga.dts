/dts-v1/;

#include "klamath.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Synaptics KLAMATH FPGA";
	compatible = "Synaptics,klamath", "Synaptics,asserial";

	memory {
		device_type = "memory";
		reg = <0 0 0 0x20000000>;
	};

	chosen {
		stdout-path = &sm_uart0;
	};
};

&pinctrl {
	mdio_pmux: mdio-pmux {
		groups = "GPIO31", "GPIO32";
		function = "rgmii";
	};

	eth0_pmux: eth0-pmux {
		groups = "GPIO33", "GPIO34", "GPIO37", "GPIO38", "GPIO41", "GPIO43", "GPIO45";
		function = "rmii1";
	};

	sd0_pmux: sd0-pmux {
		groups = "GPIO12", "GPIO22", "GPIO46", "GPIO47";
		function = "sdio1";
	};
};

&sysmgr_pinctrl {
	xspi0_pmux: xspi0-pmux {
		groups = "SM_GPIO18", "SM_GPIO19", "SM_GPIO20", "SM_GPIO21",
				 "SM_GPIO22", "SM_GPIO23", "SM_GPIO24", "SM_GPIO25",
				 "SM_GPIO26", "SM_GPIO27", "SM_GPIO28", "SM_GPIO29",
				 "SM_GPIO30";
		function = "xspi";
	};
};

&uartclk {
		clock-frequency = <48000000>;
};

&sm_uart0 {
	status = "okay";
};

&sdhci0 {
	status = "okay";
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	fixed-voltage;
};

/*
&sdhci1 {
	status = "okay";
	pinctrl-0 = <&sd0_pmux>;
	pinctrl-names = "default";
	broken-cd;
	no-mmc;
	no-sdio;
	no-1-8-v;
};
*/

&usb_phy0 {
	status = "okay";
};

&usb0 {
	status = "okay";
};

&xspi0 {
	status = "okay";
	pinctrl-0 = <&xspi0_pmux>;
	pinctrl-names = "default";

	spi-flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		//compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};
};
